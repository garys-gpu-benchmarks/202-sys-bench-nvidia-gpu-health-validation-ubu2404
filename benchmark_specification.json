  {
    "field_name": "Repo Name",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sys-bench-nvidia-gpu-health-validation-ubu2404"
  },
  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Analyze GPU CUDA runtime environment health"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates GPU visibility, temperature, PCIe width/speed, and dmesg Xid mentions. Does not run DCGM, deviceQuery, or CUDA context creation"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: GPU fault/Xid count (dmesg_nvidia_gpu_fault_xid_count); #2: GPU temperature (gpu_temperature_c); #3: PCIe link width, lanes (pcie_link_width_lanes); #4: PCIe link speed, GT/s (pcie_link_speed_gt_s); #5: CUDA devices visible (cuda_devices_visible)"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run nvidia-smi, nvidia-smi -q, nvidia-smi -L, and dmesg"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run nvidia-smi, nvidia-smi -q, nvidia-smi -L, and dmesg twice about one second apart, then parse GPU temperature, PCIe width/speed, visible device count, and case-insensitive dmesg Xid matches, to measure GPU health. CLI --pcie-check/--ecc-check and similar flags are ignored"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Sample nvidia-smi, nvidia-smi -q, nvidia-smi -L, and dmesg twice about one second apart, then parse temperature, PCIe width and speed, visible device count, and Xid matches. CLI pcie-check and ecc-check flags are ignored. DCGM and deviceQuery are not run"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Polls NVIDIA GPU health twice (~1 s apart) from nvidia-smi and dmesg. Yaml flags pcie_check, clock_check, temperature_check, power_check, ecc_check, retired_pages_check, firmware_version_check, cuda_device_check, cuda_context_check, and dmesg_check are documented but ignored by the collector. Always records device count, GPU temperature, PCIe width/speed, and case-insensitive dmesg 'xid' matches. output_format: csv"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validation / Correctness"
  },
  {
    "field_name": "Workload Category",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "System Validation & Reliability"
  },
  {
    "field_name": "Workload Type",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Test"
  },
  {
    "field_name": "Target Hardware",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "GPU"
  },
  {
    "field_name": "GPU Model",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "H100 SXM 80GB"
  },
  {
    "field_name": "Raw Output Format",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "CSV aggregate plus the dmesg transcript. A single row is duplicated to two samples"
  },
  {
    "field_name": "Primary Record Granularity",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "one aggregate CSV row, duplicated so the harness sees two samples"
  },
  {
    "field_name": "Raw Output Example",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "sample_index,status,dmesg_nvidia_gpu_fault_xid_count,gpu_temperature_c,cuda_devices_visible,pcie_link_width_lanes,pcie_link_speed_gt_s,error_message\n0,ok,0,42,1,16,32,"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --pcie-check true --clock-check true --temperature-check true --power-check true --ecc-check true --retired-pages-check true --firmware-version-check true --cuda-device-check true --cuda-context-check true --dmesg-check true --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --pcie-check true --clock-check true --temperature-check true --power-check true --ecc-check true --retired-pages-check true --firmware-version-check true --cuda-device-check true --cuda-context-check true --dmesg-check true --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
