  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates CUDA device visibility against expected_gpu_count, PCIe link width against min_pcie_link_width, PCIe speed, peak temperature over the monitor window, and NVRM Xid lines in dmesg"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run nvidia-smi --query-gpu and nvidia-smi -L once per second for monitor_duration_sec, and dmesg at the start and end, then report peak GPU temperature, the narrowest PCIe link, the fewest visible devices, and NVRM Xid lines, to measure GPU health"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Poll nvidia-smi --query-gpu (every GPU) and nvidia-smi -L once per second for monitor_duration_sec. Keep the peak temperature, the narrowest link width and slowest speed, and the fewest devices seen. Fail when fewer than expected_gpu_count devices or a link narrower than min_pcie_link_width appears. DCGM and deviceQuery are not run"
  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Samples NVIDIA GPU health once per second from nvidia-smi and counts NVRM Xid lines in dmesg since boot. monitor_duration_sec: seconds to keep sampling; temperature is the peak over the window (smoke 5 / baseline 200 / extended 580). expected_gpu_count: fewest CUDA devices that must stay visible; fewer fails the run (1). min_pcie_link_width: narrowest acceptable PCIe link, in lanes, on every GPU; narrower fails the run (16)"
  },
  {
    "field_name": "Execution Domain",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validation / Correctness"
  },
  {
    "field_name": "Workload Category",
